# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# LaTeX build artefacts (the compiled PDFs are not tracked; `paper/*.tex` is)
paper/*.aux
paper/*.log
paper/*.out
paper/*.spl
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Intermediate raster figures: only the vector PDFs are tracked, since the
# PNGs are regenerated by exp/fig_*.py
figs/*.png

# Local run reports
runs/
*.tmp
